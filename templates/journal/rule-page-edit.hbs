<div class="ffxiv-rule-page-edit">
  <div class="form-group stacked">
    <label for="{{rule.uuid}}-aliases">{{localize "FFXIV.Rules.Aliases"}}</label>
    <input id="{{rule.uuid}}-aliases" type="text" name="system.aliases" value="{{rule.aliases}}" autocomplete="off">
    <p class="hint">{{localize "FFXIV.Rules.AliasesHint"}}</p>
  </div>
  <prose-mirror name="system.content" value="{{rule.source}}" data-document-uuid="{{rule.uuid}}"></prose-mirror>
</div>
